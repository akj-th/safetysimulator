# 이 파일을 같은 폴더에 ".env" 라는 이름으로 복사한 뒤,
# 아래 줄의 여기에-키를-붙여넣으세요 부분을 발급받은 키로 바꾸세요.
#
# ★ .env 파일은 절대 GitHub에 올리지 마세요. (.gitignore로 막아 두었습니다)

# ── AI 진단 (2단계) — 필수 ──────────────────────────────────────────
# https://console.anthropic.com
ANTHROPIC_API_KEY=여기에-키를-붙여넣으세요

# ── 개선 후 이미지 생성 (4단계) — 둘 중 하나만 있어도 됩니다 ────────
# 넣은 쪽 모델만 화면의 선택 상자에 나타납니다. 둘 다 넣으면 둘 다 나오고,
# 같은 사진으로 번갈아 돌려 어느 쪽이 원본을 잘 지키는지 비교할 수 있습니다.

# Google — https://aistudio.google.com/apikey
GEMINI_API_KEY=여기에-키를-붙여넣으세요

# OpenAI — https://platform.openai.com/api-keys
# ※ 조직 인증(Verify Organization)을 마쳐야 이미지 모델을 쓸 수 있습니다.
OPENAI_API_KEY=여기에-키를-붙여넣으세요

# ── 로그인 · 접근통제 (2026-09-14) ─────────────────────────────────
# account  계정 로그인 + 관리자 승인 (기본값 — 렌더에서는 이것)
# code     예전 접속 암호(ACCESS_CODE) 방식 — 문제가 생겼을 때 되돌리기용
# off      확인 안 함 — ★ 내 컴퓨터에서 개발할 때만. 인터넷 주소에서는 절대 쓰지 마세요
#
# ⚠ account 인데 DATABASE_URL 이 없으면 사이트가 "설정 필요" 안내로 닫힙니다.
#   내 컴퓨터에서 DB 없이 화면만 보려면 AUTH_MODE=off 로 두세요.
AUTH_MODE=off

# 렌더 PostgreSQL 연결 주소
#   렌더 웹 서비스에는 Internal Database URL 을,
#   내 컴퓨터에서 붙어 보려면 External Database URL 을 넣습니다.
DATABASE_URL=

# 관리자 계정 — 서버가 켜질 때 없으면 만들고, 있으면 비밀번호를 이 값으로 다시 맞춥니다.
# 비밀번호를 잊으면 이 값만 바꾸고 서버를 다시 켜면 됩니다.
ADMIN_ID=
ADMIN_PW=

# 로그인 유지 시간(분) — 마지막 사용 후 이만큼 지나면 로그아웃. 기본 30
# SESSION_MINUTES=30

# 예전 접속 암호 — AUTH_MODE=code 일 때만 쓰입니다
# ACCESS_CODE=
