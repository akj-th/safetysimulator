# ★ API 키가 들어 있는 파일 — 절대 GitHub에 올라가면 안 됩니다
.env
*.env
!.env.example

# ★ AURI에서 받은 119 응급신고 원본 GIS 자료 — 외부 유출 불가
#   시행계획서: "외부 유출 불가한 지자체 내부 보안 환경 전제"
#   한 번 push되면 커밋 기록에 영구히 남으므로 통째로 차단합니다.
data/raw/

# ★ AURI·행안부 내부 문서와 회의록 — data/raw/ 와 같은 이유로 차단합니다.
#   이 저장소는 GitHub Pages로 공개되므로, 커밋하면 사전진단서·협의회의록과
#   회의 참석자 실명·내부 논의가 그대로 노출됩니다.
#
#   ※ 파일은 폴더에 그대로 둡니다 — 작업할 때 읽어야 하는 자료입니다.
#     커밋만 막는 것이고, 폴더 자체는 .gitkeep 으로 저장소에 남깁니다.
#     (docs/ 로 적으면 git이 폴더 안으로 들어가지 않아 .gitkeep 예외가
#      먹지 않습니다. 그래서 docs/* 로 적습니다.)
docs/*
!docs/.gitkeep
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx
*.tif
*.tiff
*.gpkg

# 설치된 라이브러리 (npm install 로 언제든 다시 받을 수 있음)
node_modules/

# 운영체제가 자동으로 만드는 파일
Thumbs.db
desktop.ini
.DS_Store
